# src/stretch/mapping/instance/, silently excluding real source.
/instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# dotenv
.env

# virtualenv
.venv
venv/
ENV/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Vim stuff
*.swp
*.swn
*.swo

# URDF files (generated/calibrated ones); the checked-in robot models
# below are loaded by src/stretch/motion/constants.py and the IK tests.
*.urdf
!src/stretch/config/urdf/*.urdf
!src/test/motion/*.urdf

# Webcam calibration images
webcam_calibration_images/

